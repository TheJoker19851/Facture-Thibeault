rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'UNKNOWN';
    }

    function isPrivileged() {
      return role() in ['KIM', 'ADMIN', 'SUPER_ADMIN'];
    }

    // Invoice evidence is private. The current baseline lets any signed-in
    // user create original images, while only privileged roles may replace or
    // delete an existing object.
    match /receipts/{year}/{month}/{receiptId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && resource == null
        && request.resource.metadata.ownerUid == request.auth.uid
        && fileName.matches('original-[0-9]{2}\\.(jpg|jpeg|png|webp|heic)')
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/jpeg|image/jpg|image/png|image/webp|image/heic)');
      allow update: if isPrivileged()
        && fileName.matches('original-[0-9]{2}\\.(jpg|jpeg|png|webp|heic)')
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/jpeg|image/jpg|image/png|image/webp|image/heic)');
      allow delete: if isPrivileged();
    }

    match /exports/{fileName=**} {
      allow read, write, delete: if isPrivileged();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'UNKNOWN';
    }

    function isPrivileged() {
      return role() in ['KIM', 'ADMIN'];
    }

    function canSubmitInvoice() {
      return role() in ['WORKER', 'KIM', 'ADMIN'];
    }

    // Invoice evidence is private. Uploaders can create original images, while
    // only privileged roles may read, replace or delete an existing object.
    match /receipts/{year}/{month}/{receiptId}/{fileName} {
      allow read: if isPrivileged();
      allow create: if canSubmitInvoice()
        && resource == null
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.receiptId == receiptId
        && request.resource.metadata.sequence.matches('[1-5]')
        && 'invoiceClientVersion' in request.resource.metadata
        && request.resource.metadata.invoiceClientVersion == 'invoice-photo-v2'
        && request.resource.size <= 12 * 1024 * 1024
        && ((fileName.matches('original-[0-9]{2}\\.jpg') && request.resource.contentType == 'image/jpeg')
          || (fileName.matches('original-[0-9]{2}\\.png') && request.resource.contentType == 'image/png')
          || (fileName.matches('original-[0-9]{2}\\.webp') && request.resource.contentType == 'image/webp'));
      // Original evidence is immutable. Privileged cleanup may delete it, but
      // no role may replace bytes or metadata in place.
      allow update: if false;
      allow delete: if isPrivileged();
    }

    match /exports/{fileName=**} {
      allow read, write, delete: if isPrivileged();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

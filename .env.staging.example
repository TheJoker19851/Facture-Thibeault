# Copier vers .env.staging.local, puis remplacer toutes les valeurs STAGING.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-facture-thibeault-staging-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-staging-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FIREBASE_PREVIEW_MODE=false
NEXT_PUBLIC_SQL_CONNECT_SERVICE_ID=facture-thibeault-service
NEXT_PUBLIC_SQL_CONNECT_LOCATION=northamerica-northeast1
NEXT_PUBLIC_SQL_CONNECT_CONNECTOR_ID=accounting
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
FIREBASE_ADMIN_PROJECT_ID=replace-with-facture-thibeault-staging-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
INVOICE_AI_MODE=live
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_LOCATION=northamerica-northeast1
GEMINI_MODEL=gemini-flash-latest
# Requis uniquement pour npm run seed:staging; ne pas réutiliser en production.
DEMO_USER_PASSWORD=
CONFIRM_STAGING_SEED=
CONFIRM_STAGING_DEPLOY=

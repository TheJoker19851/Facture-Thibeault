# Firebase web app configuration for local/staging development.
# Create the project and web app in the Firebase console before filling these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Privacy-by-default: set to true only on managed/trusted devices where
# offline work is required. Firestore caches sensitive data in the browser.
NEXT_PUBLIC_FIREBASE_OFFLINE_CACHE=false

# Optional App Check protection. Register the app first; enforcement belongs
# in the Firebase console after local testing is complete.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

# Gemini is intentionally server-side only. Never put a Gemini secret in this
# file or in a NEXT_PUBLIC_* variable.
GEMINI_LOCATION=northamerica-northeast1
GEMINI_MODEL=

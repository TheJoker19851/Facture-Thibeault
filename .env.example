# Firebase web app configuration for local/staging development.
# Create the project and web app in the Firebase console before filling these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to true only with the local Firebase emulators. Leave false for staging
# and production so local work cannot write to shared resources.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Analytics remains disabled until the privacy notice/consent flow is approved.
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=false

# Local visual preview only. Keep false for staging and production.
NEXT_PUBLIC_FIREBASE_PREVIEW_MODE=false

# SQL Connect service metadata. The connector ID is supplied by Firebase SQL
# Connect when the connector/operations are deployed; it is not a PostgreSQL
# password and is safe to expose to the web SDK. The local connector declared
# in dataconnect/accounting/ is named `accounting`.
NEXT_PUBLIC_SQL_CONNECT_SERVICE_ID=facture-thibeault-service
NEXT_PUBLIC_SQL_CONNECT_LOCATION=northamerica-northeast1
NEXT_PUBLIC_SQL_CONNECT_CONNECTOR_ID=

# Optional App Check protection. Register the app first; enforcement belongs
# in the Firebase console after local testing is complete.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

# Gemini is intentionally server-side only. Never put a Gemini secret in this
# file or in a NEXT_PUBLIC_* variable.
GEMINI_LOCATION=northamerica-northeast1
GEMINI_MODEL=

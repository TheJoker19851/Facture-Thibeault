rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'UNKNOWN';
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isAccountingOrAdmin() {
      return role() in ['ACCOUNTING', 'ADMIN'];
    }

    function isStaff() {
      return role() in ['WORKER', 'ACCOUNTING', 'ADMIN'];
    }

    // Default-deny posture. New collections must be added intentionally.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /people/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /cards/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /personCardAssociations/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /projects/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /projectVersions/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if isAdmin();
    }

    match /accountCategories/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /accountCategoryVersions/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if isAdmin();
    }

    match /vendors/{documentId} {
      allow read: if isStaff();
      allow write: if isAccountingOrAdmin();
    }

    match /skuCatalog/{documentId} {
      allow read: if isStaff();
      allow write: if isAccountingOrAdmin();
    }

    match /cardPeriods/{documentId} {
      allow read: if isStaff();
      allow write: if isAccountingOrAdmin();
    }

    match /submissions/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAccountingOrAdmin();
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if isStaff();
      allow write: if isAccountingOrAdmin();
    }

    match /images/{documentId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /transactions/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAccountingOrAdmin();
      allow delete: if false;
    }

    match /transactionLines/{documentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAccountingOrAdmin();
      allow delete: if false;
    }

    match /statementTransactions/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if isAccountingOrAdmin();
    }

    match /reconciliationMatches/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if isAccountingOrAdmin();
    }

    match /aiRuns/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if false;
    }

    match /auditLogs/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if false;
    }

    match /settings/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /archiveJobs/{documentId} {
      allow read: if isAccountingOrAdmin();
      allow write: if isAccountingOrAdmin();
    }
  }
}
